    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "System permission prompt. Machine translations require native-language review.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يحتاج Collage Magic إلى إذن لإضافة الصور المجمعة النهائية إلى مكتبة الصور الخاصة بك. لا يمكنه رؤية أو تغيير الصور الموجودة بالفعل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "আপনার ফটো লাইব্রেরিতে আপনার সমাপ্ত কোলাজগুলি যোগ করার জন্য কোলাজ ম্যাজিকের অনুমতি প্রয়োজন৷ এটি ইতিমধ্যে সেখানে থাকা ফটোগুলি দেখতে বা পরিবর্তন করতে পারে না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Collage Magic necessita permís per afegir els teus collages acabats a la teva biblioteca de fotos. No pot veure ni canviar les fotos que ja hi ha."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Collage Magic potřebuje oprávnění k přidání vašich hotových koláží do vaší knihovny fotografií. Nemůže vidět ani změnit fotografie, které tam již jsou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Collage Magic skal have tilladelse til at tilføje dine færdige collager til dit fotobibliotek. Den kan ikke se eller ændre billederne, der allerede er der."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Collage Magic benötigt die Erlaubnis, Ihre fertigen Collagen zu Ihrer Fotobibliothek hinzuzufügen. Die bereits vorhandenen Fotos können nicht angezeigt oder geändert werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το Collage Magic χρειάζεται άδεια για να προσθέσει τα τελικά κολάζ σας στη βιβλιοθήκη φωτογραφιών σας. Δεν μπορεί να δει ή να αλλάξει τις φωτογραφίες που υπάρχουν ήδη."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collage Magic needs permission to add your finished collages to your photo library. It cannot see or change the photos already there."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collage Magic needs permission to add your finished collages to your photo library. It cannot see or change the photos already there."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collage Magic needs permission to add your finished collages to your photo library. It cannot see or change the photos already there."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collage Magic needs permission to add your finished collages to your photo library. It cannot see or change the photos already there."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Collage Magic necesita permiso para agregar tus collages terminados a tu biblioteca de fotos. No puede ver ni cambiar las fotos que ya están allí."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Collage Magic necesita permiso para agregar tus collages terminados a tu biblioteca de fotos. No puede ver ni cambiar las fotos que ya están allí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Collage Magic tarvitsee luvan lisätäksesi valmiita kollaaseja valokuvakirjastoosi. Se ei voi nähdä tai muuttaa olemassa olevia kuvia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Collage Magic a besoin d'une autorisation pour ajouter vos collages terminés à votre photothèque. Il ne peut pas voir ou modifier les photos déjà présentes."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Collage Magic a besoin d'une autorisation pour ajouter vos collages terminés à votre photothèque. Il ne peut pas voir ou modifier les photos déjà présentes."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "કોલાજ મેજિકને તમારી ફોટો લાઇબ્રેરીમાં તમારા તૈયાર કોલાજ ઉમેરવા માટે પરવાનગીની જરૂર છે. તે પહેલાથી જ ત્યાં ફોટા જોઈ અથવા બદલી શકતું નથી."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Collage Magic זקוק להרשאה כדי להוסיף את הקולאז'ים המוגמרים שלך לספריית התמונות שלך. זה לא יכול לראות או לשנות את התמונות שכבר שם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कोलाज मैजिक को आपके तैयार कोलाज को आपकी फोटो लाइब्रेरी में जोड़ने के लिए अनुमति की आवश्यकता है। यह वहां पहले से मौजूद फ़ोटो को देख या बदल नहीं सकता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Collage Magic treba dopuštenje za dodavanje vaših gotovih kolaža u vašu biblioteku fotografija. Ne može vidjeti niti promijeniti fotografije koje su već tamo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A Collage Magicnek engedélyre van szüksége ahhoz, hogy a kész kollázsokat hozzáadja a fotókönyvtárához. Nem láthatja vagy módosíthatja a már meglévő képeket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Collage Magic memerlukan izin untuk menambahkan kolase Anda yang sudah selesai ke perpustakaan foto Anda. Ia tidak dapat melihat atau mengubah foto yang sudah ada di sana."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Collage Magic necessita dell'autorizzazione per aggiungere i collage finiti alla libreria di foto. Non può vedere o modificare le foto già presenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Collage Magic では、完成したコラージュを写真ライブラリに追加する許可が必要です。すでにそこにある写真を表示したり変更したりすることはできません。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ನಿಮ್ಮ ಫೋಟೋ ಲೈಬ್ರರಿಗೆ ನಿಮ್ಮ ಸಿದ್ಧಪಡಿಸಿದ ಕೊಲಾಜ್‌ಗಳನ್ನು ಸೇರಿಸಲು ಕೊಲಾಜ್ ಮ್ಯಾಜಿಕ್‌ಗೆ ಅನುಮತಿಯ ಅಗತ್ಯವಿದೆ. ಇದು ಈಗಾಗಲೇ ಫೋಟೋಗಳನ್ನು ನೋಡಲು ಅಥವಾ ಬದಲಾಯಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "완성된 콜라주를 사진 보관함에 저장하려면 'Collage Magic'에 권한이 필요합니다. 앱은 기존에 보관함에 있던 사진을 확인하거나 변경할 수 없습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "നിങ്ങളുടെ ഫോട്ടോ ലൈബ്രറിയിൽ പൂർത്തിയായ കൊളാഷുകൾ ചേർക്കാൻ കൊളാഷ് മാജിക്കിന് അനുമതി ആവശ്യമാണ്. ഇതിന് ഇതിനകം അവിടെയുള്ള ഫോട്ടോകൾ കാണാനോ മാറ്റാനോ കഴിയില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "तुमचे तयार झालेले कोलाज तुमच्या फोटो लायब्ररीमध्ये जोडण्यासाठी कोलाज मॅजिकला परवानगी आवश्यक आहे. ते आधीपासून असलेले फोटो पाहू किंवा बदलू शकत नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Collage Magic memerlukan kebenaran untuk menambahkan kolaj siap anda pada pustaka foto anda. Ia tidak dapat melihat atau menukar foto yang sudah ada."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Collage Magic trenger tillatelse for å legge til de ferdige collagene dine i fotobiblioteket ditt. Den kan ikke se eller endre bildene som allerede er der."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Collage Magic heeft toestemming nodig om je voltooide collages aan je fotobibliotheek toe te voegen. De foto's die er al zijn, kunnen niet worden bekeken of gewijzigd."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ଆପଣଙ୍କ ପ୍ରସ୍ତୁତ କୋଲାଜ୍‌ଗୁଡ଼ିକୁ ଫଟୋ ଲାଇବ୍ରେରୀରେ ଯୋଡ଼ିବା ପାଇଁ 'କୋଲାଜ୍ ମ୍ୟାଜିକ୍' (Collage Magic) କୁ ଅନୁମତି ଆବଶ୍ୟକ। ଏହା ଆପଣଙ୍କ ଫଟୋ ଲାଇବ୍ରେରୀରେ ଥିବା ଅନ୍ୟ ଫଟୋଗୁଡ଼ିକୁ ଦେଖିପାରିବ ନାହିଁ କିମ୍ବା ସେଥିରେ କୌଣସି ପରିବର୍ତ୍ତନ କରିପାରିବ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ਕੋਲਾਜ ਮੈਜਿਕ ਨੂੰ ਤੁਹਾਡੀ ਫੋਟੋ ਲਾਇਬ੍ਰੇਰੀ ਵਿੱਚ ਤੁਹਾਡੇ ਮੁਕੰਮਲ ਹੋਏ ਕੋਲਾਜ ਜੋੜਨ ਲਈ ਇਜਾਜ਼ਤ ਦੀ ਲੋੜ ਹੈ। ਇਹ ਪਹਿਲਾਂ ਤੋਂ ਮੌਜੂਦ ਫੋਟੋਆਂ ਨੂੰ ਦੇਖ ਜਾਂ ਬਦਲ ਨਹੀਂ ਸਕਦਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Collage Magic potrzebuje pozwolenia, aby dodać gotowe kolaże do Twojej biblioteki zdjęć. Nie może zobaczyć ani zmienić zdjęć, które już tam są."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Collage Magic precisa de permissão para adicionar suas colagens finalizadas à sua biblioteca de fotos. Ele não pode ver ou alterar as fotos que já estão lá."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Collage Magic precisa de autorização para adicionar as suas colagens finalizadas à sua biblioteca de fotografias. Não pode ver ou alterar as fotos que já lá estão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Collage Magic are nevoie de permisiune pentru a adăuga colajele finalizate în biblioteca ta foto. Aplicația nu poate vedea sau modifica fotografiile existente deja acolo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Приложению Collage Magic требуется разрешение на добавление готовых коллажей в вашу медиатеку. Приложение не может просматривать или изменять уже имеющиеся там фотографии."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aplikácia Collage Magic potrebuje povolenie na pridanie hotových koláží do vašej knižnice fotografií. K fotografiám, ktoré sa v nej už nachádzajú, nemá prístup a nemôže ich meniť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aplikacija Collage Magic potrebuje dovoljenje za dodajanje dokončanih kolažev v vašo knjižnico fotografij. Do obstoječih fotografij nima dostopa in jih ne more spreminjati."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Collage Magic behöver tillåtelse för att lägga till dina färdiga collage i ditt bildbibliotek. Appen kan inte se eller ändra de bilder som redan finns där."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "நீங்கள் உருவாக்கிய கோலேஜ்களை (collages) உங்கள் புகைப்பட நூலகத்தில் சேமிக்க 'கோலேஜ் மேஜிக்' (Collage Magic) செயலிக்கு அனுமதி தேவை. ஏற்கனவே உங்கள் நூலகத்தில் உள்ள புகைப்படங்களை இந்தச் செயலியால் பார்க்கவோ அல்லது மாற்றவோ முடியாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "మీరు రూపొందించిన కోలాజ్‌లను మీ ఫోటో లైబ్రరీలో సేవ్ చేయడానికి 'కోలాజ్ మ్యాజిక్' (Collage Magic)కి అనుమతి అవసరం. ఇది మీ ఫోటో లైబ్రరీలోని ఇతర ఫోటోలను చూడలేదు లేదా మార్చలేదు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Collage Magic ต้องการสิทธิ์ในการบันทึกภาพคอลลาจที่คุณทำเสร็จแล้วลงในคลังรูปภาพของคุณ โดยแอปจะไม่สามารถเข้าถึงหรือแก้ไขรูปภาพที่มีอยู่เดิมในคลังของคุณได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Collage Magic'in, hazırladığınız kolajları fotoğraf arşivinize ekleyebilmesi için izne ihtiyacı vardır. Uygulama, arşivinizdeki mevcut fotoğrafları göremez veya değiştiremez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Програмі Collage Magic потрібен дозвіл, щоб додавати готові колажі до вашої медіатеки. Вона не має доступу до наявних там фотографій і не може їх змінювати."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Collage Magic کو آپ کی تیار کردہ کولاجز (collages) کو آپ کی فوٹو لائبریری میں شامل کرنے کے لیے اجازت درکار ہے۔ یہ پہلے سے موجود تصاویر کو نہ تو دیکھ سکتا ہے اور نہ ہی ان میں کوئی تبدیلی کر سکتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Collage Magic cần quyền truy cập để lưu các tác phẩm ảnh ghép hoàn thiện của bạn vào thư viện ảnh. Ứng dụng không thể xem hoặc thay đổi các ảnh đã có sẵn trong đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Collage Magic 需要获得权限，才能将您制作完成的拼贴作品保存到您的照片图库中。应用无法查看或修改您图库中原有的照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Collage Magic 需要您的許可才能將您完成的拼貼畫新增至您的照片庫。它無法檢視或變更您照片庫中已有的照片。"
          }
        }
      }
    },
    "NSUserTrackingUsageDescription" : {
      "comment" : "System permission prompt. Machine translations require native-language review.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Collage Magic مجاني لأنه يعرض الإعلانات. إذا سمحت بالتتبع، فيمكن لشركائنا الإعلانيين عرض الإعلانات الأكثر ملاءمة لك. لا تتم مشاركة الصور ومقاطع الفيديو والموسيقى الخاصة بك أبدًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
