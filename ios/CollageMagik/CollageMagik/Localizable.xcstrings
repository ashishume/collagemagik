        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ভিডিও ক্লিপগুলিতে অংশ কাজগুলি চয়ন করুন৷ এটি ছাঁটাই করতে সঙ্গীতের প্রান্ত টেনে আনুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
