        "es-ES" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El área brillante es lo que se utiliza. Arrastra para mover, pellizca o usa el control deslizante para hacer zoom."
          }
        },
        "es-MX" : {
          "stringUnit" : {
