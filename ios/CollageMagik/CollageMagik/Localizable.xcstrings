    "Cut the video, choose its part, and set its sound and background music" : {
      "comment" : "Machine translation draft; review in context before release.\nMachine translation draft; review in context before release.\nMachine translation draft; review in context before release.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "قص الفيديو واختيار الجزء الخاص به وضبط الصوت وموسيقى الخلفية"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ভিডিওটি কাটুন, এর অংশ বেছে নিন এবং এর সাউন্ড এবং ব্যাকগ্রাউন্ড মিউজিক সেট করুন"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Retalla el vídeo, tria la seva part i defineix-ne el so i la música de fons"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vystřihněte video, vyberte jeho část a nastavte jeho zvuk a hudbu na pozadí"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Klip videoen, vælg dens del, og indstil dens lyd og baggrundsmusik"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Schneiden Sie das Video aus, wählen Sie seinen Teil aus und legen Sie den Ton und die Hintergrundmusik fest"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Κόψτε το βίντεο, επιλέξτε το μέρος του και ρυθμίστε τον ήχο και τη μουσική υπόκρουσή του"
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cut the video, choose its part, and set its sound and background music"
          }
        },
