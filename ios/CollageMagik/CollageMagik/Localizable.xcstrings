    "Emoji keep their own colors. Shapes can take any color." : {
      "comment" : "Machine translation draft; review in context before release.\nMachine translation draft; review in context before release.\nMachine translation draft; review in context before release.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الإيموجي يحتفظ بألوانه الخاصة. الأشكال يمكن أن تأخذ أي لون."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ইমোজি তাদের নিজস্ব রং রাখে। আকার যে কোনো রঙ নিতে পারে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Els emojis mantenen els seus propis colors. Les formes poden prendre qualsevol color."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Emoji si zachovávají své vlastní barvy. Tvary mohou mít jakoukoli barvu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Emoji beholder deres egne farver. Former kan tage enhver farve."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Emoji behalten ihre eigenen Farben. Formen können jede beliebige Farbe annehmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Τα emoji διατηρούν τα δικά τους χρώματα. Τα σχήματα μπορούν να πάρουν οποιοδήποτε χρώμα."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emoji keep their own colours. Shapes can take any colour."
          }
        },
        "en-CA" : {
          "stringUnit" : {
