    "Captions in 20 lettering styles, neon or vertical, plus emoji and shapes. Drag, pinch and twist to place them." : {
      "comment" : "Machine translation draft; review in context before release.\nMachine translation draft; review in context before release.\nMachine translation draft; review in context before release.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "التسميات التوضيحية في 20 نمطًا للحروف، نيون أو عمودي، بالإضافة إلى الرموز التعبيرية والأشكال. اسحب، قرصة وتطور لوضعها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "20টি অক্ষর শৈলীতে ক্যাপশন, নিয়ন বা উল্লম্ব, প্লাস ইমোজি এবং আকার। তাদের স্থাপন করতে টেনে আনুন, চিমটি করুন এবং মোচড় দিন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Subtítols en 20 estils de lletra, neó o vertical, a més d'emojis i formes. Arrossegueu, pessigueu i gireu per col·locar-los."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Popisky ve 20 stylech písma, neonové nebo vertikální, plus emotikony a tvary. Umístěte je přetažením, sevřením a otočením."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Billedtekster i 20 bogstavstilarter, neon eller lodret, plus emoji og former. Træk, klem og drej for at placere dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bildunterschriften in 20 Schriftstilen, Neon oder vertikal, plus Emojis und Formen. Ziehen, kneifen und drehen Sie, um sie zu platzieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Υπότιτλοι σε 20 στυλ γραμμάτων, νέον ή κάθετα, συν emoji και σχήματα. Σύρετε, τσιμπήστε και στρίψτε τα για να τα τοποθετήσετε."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Captions in 20 lettering styles, neon or vertical, plus emoji and shapes. Drag, pinch and twist to place them."
          }
        },
        "en-CA" : {
          "stringUnit" : {
