        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এটি আমার লাইব্রেরি থেকে সরানো হয়েছে। ফটোতে আপনার সংরক্ষিত একটি অনুলিপি প্রভাবিত হয় না।"
