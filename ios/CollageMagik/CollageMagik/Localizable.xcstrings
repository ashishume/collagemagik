    "%@ applied. Tap Edit to write your own words; Undo brings your design back." : {
      "comment" : "Machine translation draft; review in context before release.\nMachine translation draft; review in context before release.\nMachine translation draft; review in context before release.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تم تطبيق %1$@. اضغط على \"تحرير\" لكتابة كلماتك الخاصة؛ التراجع يعيد تصميمك مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ প্রয়োগ করা হয়েছে। আপনার নিজের শব্দ লিখতে সম্পাদনা আলতো চাপুন; পূর্বাবস্থায় আপনার নকশা ফিরিয়ে আনে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ aplicat. Toqueu Edita per escriure les vostres pròpies paraules; Desfés torna el teu disseny."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bylo použito %1$@. Klepněte na Upravit a napište vlastní slova; Zpět vrátí váš návrh zpět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ anvendt. Tryk på Rediger for at skrive dine egne ord; Fortryd bringer dit design tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ angewendet. Tippen Sie auf Bearbeiten, um Ihre eigenen Wörter zu schreiben. Mit „Rückgängig“ erhalten Sie Ihr Design zurück."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Εφαρμόστηκαν %1$@. Πατήστε Επεξεργασία για να γράψετε τις δικές σας λέξεις. Το Undo επαναφέρει το σχέδιό σας."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ applied. Tap Edit to write your own words; Undo brings your design back."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ applied. Tap Edit to write your own words; Undo brings your design back."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ applied. Tap Edit to write your own words; Undo brings your design back."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ applied. Tap Edit to write your own words; Undo brings your design back."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ aplicado. Toque Editar para escribir sus propias palabras; Deshacer recupera tu diseño."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ aplicado. Toque Editar para escribir sus propias palabras; Deshacer recupera tu diseño."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ sovellettu. Napauta Muokkaa kirjoittaaksesi omat sanasi; Kumoa tuo suunnittelusi takaisin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ appliqué. Appuyez sur Modifier pour écrire vos propres mots ; Annuler ramène votre conception."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ appliqué. Appuyez sur Modifier pour écrire vos propres mots ; Annuler ramène votre conception."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ લાગુ. તમારા પોતાના શબ્દો લખવા માટે સંપાદિત કરો ટેપ કરો; પૂર્વવત્ તમારી ડિઝાઇન પાછી લાવે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ הוחל. הקש על ערוך כדי לכתוב את המילים שלך; ביטול מחזיר את העיצוב שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ ने आवेदन किया। अपने शब्द लिखने के लिए संपादित करें पर टैप करें; पूर्ववत करने से आपका डिज़ाइन वापस आ जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ primijenjeno. Dodirnite Uredi za pisanje vlastitih riječi; Undo vraća vaš dizajn."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ jelentkezett. Saját szavai írásához érintse meg a Szerkesztés gombot; A visszavonás visszaállítja a tervezést."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ diterapkan. Ketuk Edit untuk menulis kata-kata Anda sendiri; Undo mengembalikan desain Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ applicato. Tocca Modifica per scrivere le tue parole; Annulla ripristina il tuo disegno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ が適用されました。 「編集」をタップして独自の言葉を作成します。元に戻すとデザインが元に戻ります。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ ಅನ್ವಯಿಸಲಾಗಿದೆ. ನಿಮ್ಮ ಸ್ವಂತ ಪದಗಳನ್ನು ಬರೆಯಲು ಸಂಪಾದಿಸು ಟ್ಯಾಪ್ ಮಾಡಿ; ರದ್ದುಮಾಡು ನಿಮ್ಮ ವಿನ್ಯಾಸವನ್ನು ಮರಳಿ ತರುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@이 적용되었습니다. 자신만의 단어를 작성하려면 편집을 탭하세요. 실행 취소를 하면 디자인이 다시 나타납니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ പ്രയോഗിച്ചു. നിങ്ങളുടെ സ്വന്തം വാക്കുകൾ എഴുതാൻ എഡിറ്റ് ടാപ്പ് ചെയ്യുക; പഴയപടിയാക്കുന്നത് നിങ്ങളുടെ ഡിസൈൻ തിരികെ കൊണ്ടുവരുന്നു."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ लागू. तुमचे स्वतःचे शब्द लिहिण्यासाठी संपादित करा टॅप करा; पूर्ववत तुमचे डिझाइन परत आणते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ digunakan. Ketik Edit untuk menulis perkataan anda sendiri; Buat asal mengembalikan reka bentuk anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ brukt. Trykk på Rediger for å skrive dine egne ord; Angre bringer designet ditt tilbake."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ toegepast. Tik op Bewerken om uw eigen woorden te schrijven; Ongedaan maken brengt uw ontwerp terug."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ ପ୍ରୟୋଗ ହୋଇଛି | ଆପଣଙ୍କର ନିଜ ଶବ୍ଦ ଲେଖିବାକୁ ସମ୍ପାଦନା ଟ୍ୟାପ୍ କରନ୍ତୁ; Undo ତୁମର ଡିଜାଇନ୍ ଫେରାଇ ଆଣିଥାଏ |"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ ਲਾਗੂ ਕੀਤਾ ਗਿਆ। ਆਪਣੇ ਸ਼ਬਦਾਂ ਨੂੰ ਲਿਖਣ ਲਈ ਸੰਪਾਦਨ 'ਤੇ ਟੈਪ ਕਰੋ; ਅਨਡੂ ਤੁਹਾਡੇ ਡਿਜ਼ਾਈਨ ਨੂੰ ਵਾਪਸ ਲਿਆਉਂਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ zastosowano. Stuknij Edytuj, aby napisać własne słowa; Cofnij przywraca projekt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ aplicado. Toque em Editar para escrever suas próprias palavras; Desfazer traz seu design de volta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
