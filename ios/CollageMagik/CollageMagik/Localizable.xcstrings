        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Emojit säilyttävät omat värinsä. Muodot voivat ottaa minkä tahansa värin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les Emoji gardent leurs propres couleurs. Les formes peuvent prendre n’importe quelle couleur."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les Emoji gardent leurs propres couleurs. Les formes peuvent prendre n’importe quelle couleur."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ઇમોજી તેમના પોતાના રંગો રાખે છે. આકારો કોઈપણ રંગ લઈ શકે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "אימוג'י שומרים על הצבעים שלהם. צורות יכולות לקחת כל צבע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इमोजी अपना रंग रखते हैं। आकृतियाँ कोई भी रंग ले सकती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Emoji zadržavaju vlastite boje. Oblici mogu uzeti bilo koju boju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A hangulatjelek megtartják saját színeiket. A formák bármilyen színt felvehetnek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Emoji menyimpan warnanya sendiri. Bentuk bisa berwarna apa saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le emoji mantengono i propri colori. Le forme possono assumere qualsiasi colore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "絵文字は独自の色を保ちます。形はどんな色でもかまいません。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ಎಮೋಜಿಗಳು ತಮ್ಮದೇ ಆದ ಬಣ್ಣಗಳನ್ನು ಇಟ್ಟುಕೊಳ್ಳುತ್ತವೆ. ಆಕಾರಗಳು ಯಾವುದೇ ಬಣ್ಣವನ್ನು ತೆಗೆದುಕೊಳ್ಳಬಹುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이모지는 고유 색상이 유지되며, 도형은 원하는 색상으로 변경할 수 있습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ഇമോജികൾ സ്വന്തം നിറങ്ങൾ നിലനിർത്തുന്നു. രൂപങ്ങൾക്ക് ഏത് നിറവും എടുക്കാം."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इमोजी त्यांचे स्वतःचे रंग ठेवतात. आकार कोणताही रंग घेऊ शकतात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Emoji mengekalkan warnanya sendiri. Bentuk boleh mengambil apa-apa warna."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Emoji beholder sine egne farger. Former kan ta hvilken som helst farge."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Emoji behouden hun eigen kleuren. Vormen kunnen elke kleur aannemen."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ଇମୋଜି ନିଜର ରଙ୍ଗ ରଖନ୍ତି | ଆକୃତିଗୁଡିକ ଯେକ any ଣସି ରଙ୍ଗ ନେଇପାରେ |"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ਇਮੋਜੀ ਆਪਣੇ ਰੰਗ ਰੱਖਦੇ ਹਨ। ਆਕਾਰ ਕੋਈ ਵੀ ਰੰਗ ਲੈ ਸਕਦੇ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Emoji zachowują swoje własne kolory. Kształty mogą przybierać dowolny kolor."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
