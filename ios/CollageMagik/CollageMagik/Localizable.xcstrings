        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bildene og videoene dine legges inn i malen i rekkefølge. Alt forblir redigerbart, og Angre bringer designet ditt tilbake."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
