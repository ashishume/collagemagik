        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Membuat baris pertama atau terakhir menjadi kecil, dengan huruf tersendiri. Letakkan setiap bagian pada barisnya masing-masing."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rende piccola la prima o l'ultima riga, con i propri caratteri. Metti ogni parte sulla propria linea."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
