          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold a photo in the tray and drag it onto the design to lay it on top."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sostenga una foto en la bandeja y arrástrela hacia el diseño para colocarla encima."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sostenga una foto en la bandeja y arrástrela hacia el diseño para colocarla encima."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pidä valokuvaa lokerossa ja vedä se kuvion päälle asettaaksesi sen päälle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tenez une photo dans le bac et faites-la glisser sur le motif pour la poser dessus."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tenez une photo dans le bac et faites-la glisser sur le motif pour la poser dessus."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ટ્રેમાં ફોટો પકડો અને તેને ટોચ પર મૂકવા માટે તેને ડિઝાઇન પર ખેંચો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "החזק תמונה במגש וגרור אותה אל העיצוב כדי להניח אותה מעל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "एक फोटो को ट्रे में रखें और इसे शीर्ष पर रखने के लिए डिज़ाइन पर खींचें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Držite fotografiju u ladici i povucite je na dizajn kako biste je postavili na vrh."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tartson egy fényképet a tálcán, és húzza rá a mintára, hogy a tetejére helyezze."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pegang foto di baki dan seret ke desain untuk meletakkannya di atas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tieni una foto nel vassoio e trascinala sul disegno per posizionarla sopra."
          }
        },
        "ja" : {
