            "value" : "“coleccionar momentos, no cosas”"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“coleccionar momentos, no cosas”"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "\"kerää hetkiä, älä asioita\""
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "\"Collectez des moments, pas des choses\""
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "\"Collectez des moments, pas des choses\""
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "\"ક્ષણો એકત્રિત કરો, વસ્તુઓ નહીં\""
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "\"לאסוף רגעים, לא דברים\""
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "\"चीजों को नहीं, क्षणों को इकट्ठा करें\""
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“skupljajte trenutke, a ne stvari”"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„a pillanatokat gyűjtsd, ne a dolgokat”"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“kumpulkan momen, bukan benda”"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“raccogliere momenti, non cose”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「物ではなく、瞬間を集めてください」"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“ಕ್ಷಣಗಳನ್ನು ಸಂಗ್ರಹಿಸಿ, ವಸ್ತುಗಳಲ್ಲ”"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“물건이 아닌 순간을 수집하세요”"
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“കാര്യങ്ങളല്ല, നിമിഷങ്ങൾ ശേഖരിക്കുക”"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“क्षण गोळा करा, गोष्टी नाही”"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "\"kumpul detik, bukan benda\""
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "\"samle øyeblikk, ikke ting\""
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“verzamel momenten, geen dingen”"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“ଜିନିଷ ନୁହେଁ, ମୁହୂର୍ତ୍ତଗୁଡ଼ିକୁ ସଂଗ୍ରହ କରନ୍ତୁ”"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "\"ਪਲਾਂ ਨੂੰ ਇਕੱਠਾ ਕਰੋ, ਚੀਜ਼ਾਂ ਨਹੀਂ\""
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„zbieraj chwile, a nie rzeczy”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“colecione momentos, não coisas”"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“colecionar momentos, não coisas”"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„adună momente, nu lucruri”"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«собирай моменты, а не вещи»"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„zbieraj okamihy, nie veci“"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "»zbiraj trenutke, ne stvari«"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "”samla på ögonblick, inte på saker”"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“பொருட்களைச் சேகரிக்காதீர்கள், தருணங்களைச் சேகரியுங்கள்”"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“వస్తువులను కాదు, క్షణాలను సేకరించండి”"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
