        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ಪ್ರಕಾಶಮಾನವಾದ ಪ್ರದೇಶವನ್ನು ಬಳಸಲಾಗಿದೆ. ಸರಿಸಲು ಎಳೆಯಿರಿ, ಪಿಂಚ್ ಮಾಡಿ ಅಥವಾ ಜೂಮ್ ಮಾಡಲು ಸ್ಲೈಡರ್ ಬಳಸಿ."
