        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Náhled karuselu, snímek %1$lld z %2$lld. Přetažením přejíždějte mezi snímky. Klepnutím na obrázek jej upravíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
