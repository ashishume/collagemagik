        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "स्लाइडों को क्रम से इंस्टाग्राम पर अपलोड करें, और जैसे ही लोग स्वाइप करते हैं तो एक सीम को पार करने वाली तस्वीरें जुड़ जाती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Učitajte slajdove na Instagram redom, a slike koje prelaze šav se spajaju dok ljudi prevlače."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Töltsd fel sorrendben a diákat az Instagramra, és a varrást keresztező képek egyesülnek, miközben az emberek csúsztatnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Unggah slide ke Instagram secara berurutan, dan gambar yang bersilangan akan bergabung saat orang menggesernya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Carica le diapositive su Instagram in ordine e le immagini che attraversano una linea di giunzione si uniscono mentre le persone scorrono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "スライドを順番に Instagram にアップロードすると、人々がスワイプすると、継ぎ目を越えた写真が結合されます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ಅನುಕ್ರಮವಾಗಿ Instagram ಗೆ ಸ್ಲೈಡ್‌ಗಳನ್ನು ಅಪ್‌ಲೋಡ್ ಮಾಡಿ ಮತ್ತು ಜನರು ಸ್ವೈಪ್ ಮಾಡುವಾಗ ಸೀಮ್ ಅನ್ನು ದಾಟಿದ ಚಿತ್ರಗಳು ಸೇರಿಕೊಳ್ಳುತ್ತವೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "슬라이드를 순서대로 인스타그램에 업로드하면, 사용자가 화면을 넘길 때 경계면이 자연스럽게 이어집니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ക്രമത്തിൽ ഇൻസ്റ്റാഗ്രാമിലേക്ക് സ്ലൈഡുകൾ അപ്‌ലോഡ് ചെയ്യുക, ആളുകൾ സ്വൈപ്പുചെയ്യുമ്പോൾ ഒരു സീം മുറിച്ചുകടക്കുന്ന ചിത്രങ്ങൾ ചേരുന്നു."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "स्लाईड इंस्टाग्रामवर क्रमाने अपलोड करा आणि लोक स्वाइप करत असताना शिवण ओलांडणारी चित्रे जोडली जातात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Muat naik slaid ke Instagram mengikut tertib dan gambar yang bersilang jahitan bercantum sebagai orang meleret."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Last opp lysbildene til Instagram i rekkefølge, og bildene som krysser en søm blir med når folk sveiper."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Upload de dia's op volgorde naar Instagram, en de foto's die een naad kruisen, komen samen als mensen vegen."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ସ୍ଲାଇଡ୍‌ଗୁଡ଼ିକୁ ଇନଷ୍ଟାଗ୍ରାମରେ କ୍ରମାନୁସାରେ ଅପଲୋଡ୍ କରନ୍ତୁ; ଏପରି କରିବା ଦ୍ୱାରା, ଯେତେବେଳେ ଲୋକମାନେ ସ୍ୱାଇପ୍ (swipe) କରିବେ, ସେତେବେଳେ ବିଭାଜନ ରେଖା (seam) ପାର ହେଉଥିବା ଚିତ୍ରଗୁଡ଼ିକ ପରସ୍ପର ସହ ଯୋଡ଼ି ହୋଇଯିବେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ਸਲਾਈਡਾਂ ਨੂੰ ਇੰਸਟਾਗ੍ਰਾਮ 'ਤੇ ਕ੍ਰਮਵਾਰ ਅਪਲੋਡ ਕਰੋ, ਅਤੇ ਇੱਕ ਸੀਮ ਨੂੰ ਪਾਰ ਕਰਨ ਵਾਲੀਆਂ ਤਸਵੀਰਾਂ ਲੋਕਾਂ ਦੁਆਰਾ ਸਵਾਈਪ ਕਰਨ ਦੇ ਨਾਲ ਜੁੜ ਜਾਂਦੀਆਂ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przesyłaj slajdy do Instagrama w odpowiedniej kolejności, a zdjęcia, które krzyżują się ze sobą, łączą się, gdy ludzie przesuwają palcem."
