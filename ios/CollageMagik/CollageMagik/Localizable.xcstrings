        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "മുകളിലെ ഫോട്ടോകൾക്കും സെല്ലുകളിലെ ചിത്രങ്ങൾക്ക് സമാനമായ ഉപകരണങ്ങൾ ഉണ്ട്: മാറ്റുക, തിരിക്കുക, ഫ്ലിപ്പ് ചെയ്യുക, ക്രോപ്പ് ചെയ്യുക, സൂം ചെയ്യുക."
