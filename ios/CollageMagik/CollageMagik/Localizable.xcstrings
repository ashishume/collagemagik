        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "તમે કેટલા ચિત્રો ઉમેરશો તે લેઆઉટ અનુસરે છે (%1$lld સુધી). એક પસંદ કરો, પછી તેનું કદ, અંતર, પૃષ્ઠભૂમિ અને ફ્રેમ શૈલીમાં સેટ કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הפריסות עוקבות אחר מספר התמונות שאתה מוסיף (עד %1$lld). בחר אחד, ולאחר מכן הגדר את הגודל, המרווח, הרקע והמסגרת שלו בסגנון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "लेआउट इस बात का अनुसरण करते हैं कि आप कितनी तस्वीरें जोड़ते हैं (%1$lld तक)। किसी एक को चुनें, फिर उसका आकार, रिक्ति, पृष्ठभूमि और फ़्रेम को स्टाइल में सेट करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Izgledi slijede koliko slika dodate (do %1$lld). Odaberite jedan, zatim postavite njegovu veličinu, razmak, pozadinu i okvir u Stilu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az elrendezések követik, hogy hány képet ad hozzá (legfeljebb %1$lld). Válasszon egyet, majd állítsa be a méretét, a térközt, a hátteret és a keretet a Stílusban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tata letaknya mengikuti jumlah gambar yang Anda tambahkan (hingga %1$lld). Pilih salah satu, lalu atur ukuran, spasi, latar belakang, dan bingkainya di Style."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I layout seguono il numero di immagini aggiunte (fino a %1$lld). Scegline uno, quindi impostane le dimensioni, la spaziatura, lo sfondo e la cornice in Stile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "レイアウトは、追加した写真の数に従います (最大 %1$lld)。 1 つを選択し、スタイルでサイズ、間隔、背景、フレームを設定します。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ನೀವು ಎಷ್ಟು ಚಿತ್ರಗಳನ್ನು ಸೇರಿಸುತ್ತೀರಿ (%1$lld ವರೆಗೆ) ಲೇಔಟ್‌ಗಳು ಅನುಸರಿಸುತ್ತವೆ. ಒಂದನ್ನು ಆರಿಸಿ, ನಂತರ ಅದರ ಗಾತ್ರ, ಅಂತರ, ಹಿನ್ನೆಲೆ ಮತ್ತು ಫ್ರೇಮ್ ಅನ್ನು ಶೈಲಿಯಲ್ಲಿ ಹೊಂದಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "레이아웃은 추가한 사진 수에 따라 결정됩니다(최대 %1$lld장). 하나를 선택한 후, '스타일'에서 크기, 간격, 배경 및 프레임을 설정하세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "നിങ്ങൾ എത്ര ചിത്രങ്ങൾ ചേർക്കുന്നു (%1$lld വരെ) ലേഔട്ടുകൾ പിന്തുടരുന്നു. ഒരെണ്ണം തിരഞ്ഞെടുക്കുക, തുടർന്ന് അതിൻ്റെ വലുപ്പം, സ്‌പെയ്‌സിംഗ്, പശ്ചാത്തലം, ഫ്രെയിം എന്നിവ സ്റ്റൈലിൽ സജ്ജീകരിക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "लेआउट तुम्ही किती चित्रे जोडता याचे अनुसरण करतात (%1$lld पर्यंत). एक निवडा, नंतर त्याचा आकार, अंतर, पार्श्वभूमी आणि फ्रेम शैलीमध्ये सेट करा."
          }
        },
        "ms" : {
          "stringUnit" : {
