        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ഇത് എൻ്റെ ലൈബ്രറിയിൽ നിന്ന് നീക്കം ചെയ്‌തു. നിങ്ങൾ ഫോട്ടോകളിൽ സംരക്ഷിച്ച ഒരു പകർപ്പിനെ ബാധിക്കില്ല."
          }
