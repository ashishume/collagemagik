        },
        "or" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ଆପଣଙ୍କ ଫଟୋ ଏବଂ ଭିଡିଓଗୁଡ଼ିକ କ୍ରମାନୁସାରେ ଟେମ୍ପଲେଟ୍ (template) ମଧ୍ୟରେ ସ୍ଥାନିତ ହେବ। ଆପଣ ଯେକୌଣସି ସମୟରେ ଏଥିରେ ପରିବର୍ତ୍ତନ କରିପାରିବେ ଏବଂ 'Undo' (ଅନଡୁ) ବ୍ୟବହାର କରି ପୂର୍ବ ଅବସ୍ଥାକୁ ଫେରିପାରିବେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
