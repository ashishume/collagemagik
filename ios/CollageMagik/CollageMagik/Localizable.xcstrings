        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ಆಯ್ಕೆಮಾಡಿದ ಚಿತ್ರವನ್ನು ಸರಿಸಲು ಎಳೆಯಿರಿ, ಜೂಮ್ ಮಾಡಲು ಅಥವಾ ಮರುಗಾತ್ರಗೊಳಿಸಲು ಪಿಂಚ್ ಮಾಡಿ ಮತ್ತು ಅದನ್ನು ತಿರುಗಿಸಲು ಅಥವಾ ನೇರಗೊಳಿಸಲು ಎರಡು ಬೆರಳುಗಳಿಂದ ಟ್ವಿಸ್ಟ್ ಮಾಡಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "선택한 사진을 드래그하여 이동하고, 손가락으로 오므리거나 벌려 크기를 조절하며, 두 손가락을 돌려 회전하거나 똑바로 정렬할 수 있습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "തിരഞ്ഞെടുത്ത ചിത്രം നീക്കാൻ അത് വലിച്ചിടുക, സൂം ചെയ്യാനോ വലുപ്പം മാറ്റാനോ പിഞ്ച് ചെയ്യുക, തിരിയാനോ നേരെയാക്കാനോ രണ്ട് വിരലുകൾ ഉപയോഗിച്ച് വളച്ചൊടിക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "निवडलेले चित्र हलविण्यासाठी ड्रॅग करा, झूम करण्यासाठी किंवा आकार बदलण्यासाठी पिंच करा आणि ते वळवण्यासाठी किंवा सरळ करण्यासाठी दोन बोटांनी वळवा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seret gambar yang dipilih untuk mengalihkannya, cubit untuk mengezum atau mengubah saiznya dan putar dengan dua jari untuk memusing atau meluruskannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
