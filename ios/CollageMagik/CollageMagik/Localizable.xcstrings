        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$lld fps પર AAC અવાજ સાથે H.264 વિડિયો. તમારી મૂળ ફાઇલો સંપૂર્ણ ગુણવત્તા પર ફરીથી વાંચવામાં આવે છે. જ્યાં સુધી તે પૂર્ણ ન થાય ત્યાં સુધી સ્ક્રીન ચાલુ રાખો.%2$@"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "וידאו H.264 עם צליל AAC ב-%1$lld פריימים לשנייה. הקבצים המקוריים שלך נקראים מחדש באיכות מלאה. השאר את המסך דולק עד שייגמר.%2$@"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "एच.264 वीडियो %1$lld एफपीएस पर एएसी ध्वनि के साथ। आपकी मूल फ़ाइलें पूरी गुणवत्ता के साथ दोबारा पढ़ी जाती हैं। स्क्रीन समाप्त होने तक चालू रखें।%2$@"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "H.264 video s AAC zvukom pri %1$lld fps. Vaše izvorne datoteke ponovno se čitaju u punoj kvaliteti. Držite zaslon uključen dok ne završi.%2$@"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "H.264 videó AAC hanggal %1$lld képkocka/mp sebességgel. Az eredeti fájlokat a rendszer teljes minőségben újraolvassa. Tartsa bekapcsolva a képernyőt, amíg be nem fejeződik.%2$@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Video H.264 dengan suara AAC pada %1$lld fps. File asli Anda dibaca ulang dengan kualitas penuh. Aktifkan layar sampai selesai.%2$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Video H.264 con audio AAC a %1$lld fps. I tuoi file originali vengono riletti alla massima qualità. Mantieni lo schermo acceso finché non termina.%2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$lld fps の AAC サウンドを含む H.264 ビデオ。元のファイルは最高の品質で再読み取りされます。終了するまで画面をオンにしておきます。%2$@"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$lld fps ನಲ್ಲಿ AAC ಧ್ವನಿಯೊಂದಿಗೆ H.264 ವೀಡಿಯೊ. ನಿಮ್ಮ ಮೂಲ ಫೈಲ್‌ಗಳನ್ನು ಪೂರ್ಣ ಗುಣಮಟ್ಟದಲ್ಲಿ ಮರು-ಓದಲಾಗುತ್ತದೆ. ಅದು ಮುಗಿಯುವವರೆಗೆ ಪರದೆಯನ್ನು ಆನ್ ಮಾಡಿ.%2$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$lld fps의 AAC 오디오가 포함된 H.264 비디오입니다. 원본 파일은 최고 화질로 다시 읽어들여 처리됩니다. 작업이 완료될 때까지 화면을 켜진 상태로 유지하세요.%2$@"
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$lld fps-ൽ AAC ശബ്‌ദമുള്ള H.264 വീഡിയോ. നിങ്ങളുടെ യഥാർത്ഥ ഫയലുകൾ പൂർണ്ണ നിലവാരത്തിൽ വീണ്ടും വായിക്കുന്നു. പൂർത്തിയാകുന്നത് വരെ സ്‌ക്രീൻ ഓണാക്കി വയ്ക്കുക.%2$@"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$lld fps वर AAC ध्वनीसह H.264 व्हिडिओ. तुमच्या मूळ फायली पूर्ण गुणवत्तेत पुन्हा वाचल्या जातात. स्क्रीन पूर्ण होईपर्यंत चालू ठेवा.%2$@"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Video H.264 dengan bunyi AAC pada %1$lld fps. Fail asal anda dibaca semula pada kualiti penuh. Pastikan skrin dihidupkan sehingga ia selesai.%2$@"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "H.264-video med AAC-lyd ved %1$lld fps. De originale filene dine leses på nytt i full kvalitet. Hold skjermen på til den er ferdig.%2$@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "H.264-video met AAC-geluid bij %1$lld fps. Uw originele bestanden worden opnieuw gelezen in volledige kwaliteit. Laat het scherm ingeschakeld totdat het klaar is.%2$@"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$lld fps ରେ AAC ସାଉଣ୍ଡ୍ ସହିତ H.264 ଭିଡିଓ। ଆପଣଙ୍କ ମୂଳ ଫାଇଲଗୁଡ଼ିକୁ ସମ୍ପୂର୍ଣ୍ଣ ଗୁଣବତ୍ତା (full quality) ସହିତ ପୁନର୍ବାର ପଢ଼ାଯାଉଛି। ପ୍ରକ୍ରିୟା ଶେଷ ନହେବା ପର୍ଯ୍ୟନ୍ତ ସ୍କ୍ରିନ୍‌କୁ ଚାଲୁ ରଖନ୍ତୁ।%2$@"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$lld fps 'ਤੇ AAC ਆਵਾਜ਼ ਦੇ ਨਾਲ H.264 ਵੀਡੀਓ। ਤੁਹਾਡੀਆਂ ਮੂਲ ਫ਼ਾਈਲਾਂ ਪੂਰੀ ਕੁਆਲਿਟੀ 'ਤੇ ਮੁੜ-ਪੜ੍ਹੀਆਂ ਜਾਂਦੀਆਂ ਹਨ। ਸਕ੍ਰੀਨ ਨੂੰ ਉਦੋਂ ਤੱਕ ਚਾਲੂ ਰੱਖੋ ਜਦੋਂ ਤੱਕ ਇਹ ਪੂਰਾ ਨਹੀਂ ਹੋ ਜਾਂਦਾ।%2$@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wideo H.264 z dźwiękiem AAC przy %1$lld fps. Twoje oryginalne pliki zostaną ponownie odczytane w pełnej jakości. Nie wyłączaj ekranu, aż się zakończy.%2$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vídeo H.264 com som AAC a %1$lld fps. Seus arquivos originais são relidos com qualidade total. Mantenha a tela ligada até terminar.%2$@"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
