        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "जैसे ही आप संपादित करते हैं, सहेजा जाता है। ड्राफ्ट पर काम जारी रखने के लिए उस पर टैप करें; इसे हटाने के लिए स्पर्श करके रखें."
