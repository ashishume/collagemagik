        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nahrajte snímky na Instagram v správnom poradí – obrázky, ktoré na seba nadväzujú, pri posúvaní prstom vytvoria plynulý prechod."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Naložite diapozitive na Instagram v pravilnem vrstnem redu; slike, ki se stikajo na robu, se med drsenjem povežejo v celoto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ladda upp bilderna till Instagram i rätt ordning, så att bilderna som ligger över en skarv hänger ihop när man sveper."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ஸ்லைடுகளை Instagram-இல் வரிசையாகப் பதிவேற்றவும்; அப்போது, ​​ஸ்லைடுகளுக்கு இடையிலான இணைப்பில் உள்ள படங்கள், பயனர்கள் ஸ்வைப் செய்யும்போது ஒன்றிணைந்து முழுமையாகத் தெரியும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "స్లైడ్‌లను వరుస క్రమంలో ఇన్‌స్టాగ్రామ్‌లో అప్‌లోడ్ చేయండి; ఇలా చేయడం వల్ల, వినియోగదారులు స్లైడ్ చేస్తున్నప్పుడు, విభజన రేఖ వద్ద ఉన్న చిత్రాలు ఒకదానితో ఒకటి కలిసి కనిపిస్తాయి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "อัปโหลดสไลด์ไปยัง Instagram ตามลำดับ โดยรูปภาพที่อยู่ตรงรอยต่อจะเชื่อมต่อกันเมื่อผู้ใช้ปัดหน้าจอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Slaytları Instagram'a sırasıyla yükleyin; böylece birleşim yerlerine denk gelen resimler, kullanıcılar kaydırdıkça birleşerek tek bir bütün oluşturur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Завантажте слайди в Instagram по черзі — зображення, що перетинають межу між ними, з’єднуватимуться, коли користувачі гортатимуть стрічку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "سلائیڈز کو ترتیب سے انسٹاگرام پر اپ لوڈ کریں؛ اس طرح، جب لوگ سوائپ (swipe) کریں گے تو جوڑ (seam) پر موجود تصاویر آپس میں جڑ جائیں گی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hãy đăng các slide lên Instagram theo thứ tự; những hình ảnh nằm vắt qua ranh giới giữa các slide sẽ kết nối với nhau khi người dùng vuốt xem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "按顺序将幻灯片上传至 Instagram；当用户滑动查看时，跨越拼接处的图片会连成一体。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "依序將投影片上傳到 Instagram，當使用者滑動時，跨越接縫的圖片會自動拼接在一起。"
          }
        }
      }
