        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$lld fps પર AAC અવાજ સાથે HDR વિડિયો (10-bit HEVC, HLG). તમારી HDR ક્લિપ્સ તેમની તેજસ્વી હાઇલાઇટ્સ રાખે છે; ફોટા અને કૅપ્શન સામાન્ય તેજ પર રહે છે. જ્યાં સુધી તે સમાપ્ત ન થાય ત્યાં સુધી સ્ક્રીન ચાલુ રાખો."
          }
        },
        "he" : {
