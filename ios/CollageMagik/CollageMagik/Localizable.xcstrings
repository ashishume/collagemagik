    "Pictures cross the edges of your slides, so people keep swiping. Up to 20 photos, slides added for you." : {
      "comment" : "Machine translation draft; review in context before release.\nMachine translation draft; review in context before release.\nMachine translation draft; review in context before release.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تتقاطع الصور مع حواف الشرائح، لذا يستمر الأشخاص في الضرب. تمت إضافة ما يصل إلى 20 صورة وشرائح لك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ছবিগুলি আপনার স্লাইডের প্রান্ত অতিক্রম করে, তাই লোকেরা সোয়াইপ করতে থাকে৷ 20টি ফটো পর্যন্ত, আপনার জন্য স্লাইড যোগ করা হয়েছে৷"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les imatges travessen les vores de les diapositives, de manera que la gent segueix fent lliscar el dit. S'han afegit fins a 20 fotos, diapositives."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Obrázky překračují okraje vašich snímků, takže lidé nepřestávají přejíždět. Až 20 fotografií, diapozitivů přidaných za vás."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Billeder krydser kanterne af dine dias, så folk bliver ved med at stryge. Op til 20 billeder, dias tilføjet til dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bilder ragen über die Ränder Ihrer Folien hinaus, sodass die Leute ständig darüber wischen. Bis zu 20 Fotos und Dias für Sie hinzugefügt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Οι φωτογραφίες διασχίζουν τις άκρες των διαφανειών σας, έτσι ώστε οι άνθρωποι να συνεχίζουν να σαρώνουν. Έως 20 φωτογραφίες, προστέθηκαν διαφάνειες για εσάς."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pictures cross the edges of your slides, so people keep swiping. Up to 20 photos, slides added for you."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pictures cross the edges of your slides, so people keep swiping. Up to 20 photos, slides added for you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pictures cross the edges of your slides, so people keep swiping. Up to 20 photos, slides added for you."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pictures cross the edges of your slides, so people keep swiping. Up to 20 photos, slides added for you."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las imágenes cruzan los bordes de las diapositivas, por lo que la gente sigue deslizándose. Hasta 20 fotos, diapositivas agregadas para usted."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las imágenes cruzan los bordes de las diapositivas, por lo que la gente sigue deslizándose. Hasta 20 fotos, diapositivas agregadas para usted."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kuvat ylittävät diojesi reunojen, joten ihmiset jatkavat pyyhkäisemistä. Jopa 20 valokuvaa, diat lisätty puolestasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les images traversent les bords de vos diapositives, de sorte que les gens continuent de les glisser. Jusqu'à 20 photos, diapositives ajoutées pour vous."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les images traversent les bords de vos diapositives, de sorte que les gens continuent de les glisser. Jusqu'à 20 photos, diapositives ajoutées pour vous."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ચિત્રો તમારી સ્લાઇડ્સની કિનારીઓને પાર કરે છે, જેથી લોકો સ્વાઇપ કરતા રહે છે. 20 જેટલા ફોટા, તમારા માટે સ્લાઇડ્સ ઉમેરવામાં આવી છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "תמונות חוצות את הקצוות של השקופיות שלך, כך שאנשים ממשיכים להחליק. עד 20 תמונות, שקופיות נוספו עבורך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "तस्वीरें आपकी स्लाइड के किनारों को पार करती हैं, इसलिए लोग स्वाइप करते रहते हैं। आपके लिए अधिकतम 20 फ़ोटो, स्लाइड जोड़ी गईं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Slike prelaze rubove vaših slajdova, pa ljudi neprestano prelaze. Do 20 fotografija, slajdova dodanih za vas."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A képek keresztezik a diák széleit, így az emberek folyamatosan csúsztatnak. Akár 20 fotó, diák hozzáadva az Ön számára."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
