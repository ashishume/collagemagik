          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Versleep de geselecteerde afbeelding om deze te verplaatsen, knijp om in te zoomen of de grootte ervan te wijzigen, en draai met twee vingers om deze te draaien of recht te trekken."
