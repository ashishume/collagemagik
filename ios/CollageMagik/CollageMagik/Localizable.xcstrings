    "There is no account and nothing is uploaded. Deleting the app deletes your library." : {
      "comment" : "Machine translation draft; review in context before release.\nMachine translation draft; review in context before release.\nMachine translation draft; review in context before release.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لا يوجد حساب ولم يتم تحميل أي شيء. يؤدي حذف التطبيق إلى حذف مكتبتك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "কোন অ্যাকাউন্ট নেই এবং কিছুই আপলোড করা হয় না। অ্যাপটি মুছে দিলে আপনার লাইব্রেরি মুছে যাবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No hi ha cap compte i no s'ha carregat res. Si suprimeixes l'aplicació, s'elimina la teva biblioteca."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Neexistuje žádný účet a nic se nenahrává. Smazáním aplikace smažete svou knihovnu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der er ingen konto, og intet er uploadet. Sletning af appen sletter dit bibliotek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Es gibt kein Konto und es wird nichts hochgeladen. Durch das Löschen der App wird Ihre Bibliothek gelöscht."
          }
        },
