    "Hold a photo in the tray and drag it onto the design to lay it on top." : {
      "comment" : "Machine translation draft; review in context before release.\nMachine translation draft; review in context before release.\nMachine translation draft; review in context before release.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أمسك صورة في الدرج واسحبها إلى التصميم لوضعها في الأعلى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ট্রেতে একটি ফটো ধরে রাখুন এবং এটিকে উপরে রাখার জন্য ডিজাইনের উপর টেনে আনুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Manteniu una foto a la safata i arrossegueu-la al disseny per col·locar-la a sobre."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Podržte fotografii v přihrádce a přetáhněte ji na návrh, abyste ji položili nahoru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hold et foto i bakken, og træk det ind på designet for at lægge det ovenpå."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Halten Sie ein Foto in die Ablage und ziehen Sie es auf das Design, um es darauf zu legen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Κρατήστε μια φωτογραφία στο δίσκο και σύρετέ την πάνω στο σχέδιο για να την τοποθετήσετε στην κορυφή."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold a photo in the tray and drag it onto the design to lay it on top."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold a photo in the tray and drag it onto the design to lay it on top."
          }
        },
        "en-GB" : {
