        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "האזור הבהיר הוא מה שמשתמשים בו. גרור כדי להזיז, לצבוט או להשתמש במחוון כדי להתקרב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "उज्ज्वल क्षेत्र का उपयोग किया जाता है। स्थानांतरित करने के लिए खींचें, पिंच करें या ज़ूम करने के लिए स्लाइडर का उपयोग करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Koristi se svijetlo područje. Povucite za pomicanje, stisnite prste ili koristite klizač za zumiranje."
