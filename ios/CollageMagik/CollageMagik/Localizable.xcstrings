        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Povlecite izbrano sliko, da jo premaknete, stisnite prste, da jo povečate ali spremenite velikost, in zavrtite z dvema prstoma, da jo obrnete ali poravnate."
