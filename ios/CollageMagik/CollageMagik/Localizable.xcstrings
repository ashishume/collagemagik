        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Povucite odabranu sliku da je pomaknete, spojite prste da biste je zumirali ili joj promijenili veličinu, i zakrenite s dva prsta da biste je okrenuli ili izravnali."
